{
  "name": "MovimentacaoEstoque",
  "type": "object",
  "description": "Hist\u00f3rico de movimenta\u00e7\u00f5es de estoque",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa (tenant)"
    },
    "loja_id": {
      "type": "string",
      "description": "ID da loja"
    },
    "produto_id": {
      "type": "string",
      "description": "ID do produto"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "entrada",
        "saida",
        "ajuste",
        "transferencia",
        "producao",
        "perda",
        "contagem"
      ],
      "description": "Tipo de movimenta\u00e7\u00e3o"
    },
    "quantidade": {
      "type": "number",
      "description": "Quantidade movimentada (positivo ou negativo)"
    },
    "quantidade_anterior": {
      "type": "number",
      "description": "Quantidade antes da movimenta\u00e7\u00e3o"
    },
    "quantidade_posterior": {
      "type": "number",
      "description": "Quantidade ap\u00f3s a movimenta\u00e7\u00e3o"
    },
    "custo_unitario": {
      "type": "number",
      "description": "Custo unit\u00e1rio na movimenta\u00e7\u00e3o"
    },
    "custo_total": {
      "type": "number",
      "description": "Custo total da movimenta\u00e7\u00e3o"
    },
    "documento_tipo": {
      "type": "string",
      "enum": [
        "nota_fiscal",
        "pedido_compra",
        "producao",
        "transferencia",
        "ajuste_manual",
        "contagem"
      ],
      "description": "Tipo do documento de origem"
    },
    "documento_id": {
      "type": "string",
      "description": "ID do documento de origem"
    },
    "loja_destino_id": {
      "type": "string",
      "description": "Loja destino (para transfer\u00eancias)"
    },
    "observacao": {
      "type": "string"
    }
  },
  "required": [
    "empresa_id",
    "loja_id",
    "produto_id",
    "tipo",
    "quantidade"
  ]
}