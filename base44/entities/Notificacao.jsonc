{
  "name": "Notificacao",
  "type": "object",
  "description": "Alertas e notifica\u00e7\u00f5es geradas pela IA financeira",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa (tenant)"
    },
    "loja_id": {
      "type": "string",
      "description": "ID da loja (opcional, se relevante)"
    },
    "tipo_alerta": {
      "type": "string",
      "enum": [
        "conta_vencida",
        "conta_vencendo",
        "saldo_negativo",
        "cmv_alto",
        "despesa_anormal",
        "banco_virtual_negativo",
        "faturamento_baixo",
        "estoque_critico",
        "fluxo_caixa_tenso",
        "outro"
      ],
      "description": "Tipo de evento detectado"
    },
    "gravidade": {
      "type": "string",
      "enum": [
        "baixa",
        "media",
        "alta",
        "critica"
      ],
      "default": "media",
      "description": "N\u00edvel de severidade do alerta"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo resumido do alerta"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o clara e acion\u00e1vel em linguagem simples"
    },
    "sugestao_ia": {
      "type": "string",
      "description": "Recomenda\u00e7\u00e3o de a\u00e7\u00e3o gerada pela IA"
    },
    "dados_referencia": {
      "type": "object",
      "description": "Dados estruturados que geraram o alerta (contas, produtos, valores)"
    },
    "entidade_tipo": {
      "type": "string",
      "enum": [
        "ContaPagar",
        "ContaReceber",
        "Estoque",
        "BancoVirtual",
        "Venda",
        "ContaBancaria",
        "outro"
      ],
      "description": "Tipo de entidade relacionada"
    },
    "entidade_id": {
      "type": "string",
      "description": "ID da entidade relacionada"
    },
    "lida": {
      "type": "boolean",
      "default": false,
      "description": "Usu\u00e1rio viu a notifica\u00e7\u00e3o"
    },
    "acao_tomada": {
      "type": "string",
      "description": "A\u00e7\u00e3o que o usu\u00e1rio realizou (ignorar, resolver, etc)"
    },
    "data_acao": {
      "type": "string",
      "format": "date-time",
      "description": "Quando o usu\u00e1rio interagiu com o alerta"
    },
    "notificacao_enviada": {
      "type": "boolean",
      "default": false,
      "description": "Se push notification foi enviado (B17+)"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativa",
        "resolvida",
        "ignorada"
      ],
      "default": "ativa",
      "description": "Estado do alerta"
    }
  },
  "required": [
    "empresa_id",
    "tipo_alerta",
    "gravidade",
    "titulo",
    "descricao"
  ]
}