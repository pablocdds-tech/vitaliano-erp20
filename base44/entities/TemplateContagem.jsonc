{
  "name": "TemplateContagem",
  "type": "object",
  "description": "Template reutiliz\u00e1vel para gera\u00e7\u00e3o de contagens peri\u00f3dicas",
  "properties": {
    "empresa_id": {
      "type": "string"
    },
    "loja_id": {
      "type": "string"
    },
    "nome": {
      "type": "string"
    },
    "periodicidade_tipo": {
      "type": "string",
      "enum": [
        "diaria",
        "semanal",
        "mensal"
      ],
      "default": "semanal"
    },
    "periodicidade_dias_semana": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "0=Dom, 1=Seg...6=Sab (para semanal)"
    },
    "periodicidade_dia_mes": {
      "type": "number",
      "description": "Dia do m\u00eas (para mensal)"
    },
    "tarefas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "responsavel_nome": {
            "type": "string"
          },
          "grupo": {
            "type": "string"
          },
          "itens": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "produto_id": {
                  "type": "string"
                },
                "produto_nome": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "observacoes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "inativo"
      ],
      "default": "ativo"
    }
  },
  "required": [
    "loja_id",
    "nome"
  ]
}