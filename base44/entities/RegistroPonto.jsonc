{
  "name": "RegistroPonto",
  "type": "object",
  "description": "Registro de ponto eletr\u00f4nico com reconhecimento facial",
  "properties": {
    "funcionario_id": {
      "type": "string"
    },
    "loja_id": {
      "type": "string"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data do registro"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "entrada",
        "saida_descanso",
        "volta_descanso",
        "saida"
      ],
      "description": "Tipo de marca\u00e7\u00e3o"
    },
    "horario": {
      "type": "string",
      "format": "date-time",
      "description": "Hor\u00e1rio exato da marca\u00e7\u00e3o"
    },
    "foto_url": {
      "type": "string",
      "description": "Foto capturada no momento"
    },
    "confianca_reconhecimento": {
      "type": "number",
      "description": "Score de confian\u00e7a do match facial (0 a 1)"
    },
    "metodo_autenticacao": {
      "type": "string",
      "enum": [
        "facial",
        "pin_backup",
        "manual_gestor"
      ],
      "default": "facial"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "observacao": {
      "type": "string"
    },
    "editado_por": {
      "type": "string"
    },
    "editado_em": {
      "type": "string",
      "format": "date-time"
    },
    "dispositivo": {
      "type": "string"
    }
  },
  "required": [
    "funcionario_id",
    "tipo",
    "horario"
  ]
}