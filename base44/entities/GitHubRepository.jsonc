{
  "name": "GitHubRepository",
  "type": "object",
  "properties": {
    "owner": {
      "type": "string"
    },
    "repo": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "html_url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "default_branch": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "stars": {
      "type": "number",
      "default": 0
    },
    "forks": {
      "type": "number",
      "default": 0
    },
    "watchers": {
      "type": "number",
      "default": 0
    },
    "open_issues": {
      "type": "number",
      "default": 0
    },
    "size": {
      "type": "number",
      "default": 0
    },
    "visibility": {
      "type": "string"
    },
    "pushed_at": {
      "type": "string",
      "format": "date-time"
    },
    "github_created_at": {
      "type": "string",
      "format": "date-time"
    },
    "github_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time"
    },
    "latest_commits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "latest_release": {
      "type": "object",
      "additionalProperties": true
    },
    "raw": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "owner",
    "repo",
    "full_name",
    "html_url"
  ]
}