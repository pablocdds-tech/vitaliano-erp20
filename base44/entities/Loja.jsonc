{
  "name": "Loja",
  "type": "object",
  "description": "Unidade operacional (CD ou Loja)",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa (tenant)"
    },
    "nome": {
      "type": "string",
      "description": "Nome da loja"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo interno da loja"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "cd",
        "loja"
      ],
      "description": "Tipo: CD (Centro Distribui\u00e7\u00e3o) ou Loja"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ da unidade"
    },
    "endereco": {
      "type": "object",
      "properties": {
        "logradouro": {
          "type": "string"
        },
        "numero": {
          "type": "string"
        },
        "complemento": {
          "type": "string"
        },
        "bairro": {
          "type": "string"
        },
        "cidade": {
          "type": "string"
        },
        "estado": {
          "type": "string"
        },
        "cep": {
          "type": "string"
        }
      }
    },
    "contato": {
      "type": "object",
      "properties": {
        "telefone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "responsavel": {
          "type": "string"
        }
      }
    },
    "saldo_banco_virtual": {
      "type": "number",
      "default": 0,
      "description": "Saldo atual no banco virtual"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "inativo"
      ],
      "default": "ativo"
    }
  },
  "required": [
    "nome",
    "tipo"
  ]
}