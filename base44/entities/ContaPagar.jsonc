{
  "name": "ContaPagar",
  "type": "object",
  "description": "Contas a pagar",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa (tenant)"
    },
    "loja_id": {
      "type": "string",
      "description": "ID da loja"
    },
    "fornecedor_id": {
      "type": "string",
      "description": "ID do fornecedor"
    },
    "categoria_dre_id": {
      "type": "string",
      "description": "Categoria para DRE"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da conta"
    },
    "credor_nome": {
      "type": "string",
      "description": "Nome do credor"
    },
    "credor_tipo": {
      "type": "string",
      "enum": [
        "fornecedor",
        "banco",
        "servico",
        "aluguel",
        "outro"
      ],
      "default": "fornecedor"
    },
    "documento_tipo": {
      "type": "string",
      "enum": [
        "nota_fiscal",
        "boleto",
        "fatura",
        "contrato",
        "outros"
      ],
      "default": "nota_fiscal"
    },
    "documento_numero": {
      "type": "string"
    },
    "documento_id": {
      "type": "string",
      "description": "ID do documento relacionado"
    },
    "data_emissao": {
      "type": "string",
      "format": "date"
    },
    "data_vencimento": {
      "type": "string",
      "format": "date"
    },
    "data_pagamento": {
      "type": "string",
      "format": "date"
    },
    "valor_original": {
      "type": "number"
    },
    "valor_desconto": {
      "type": "number",
      "default": 0
    },
    "valor_juros": {
      "type": "number",
      "default": 0
    },
    "valor_multa": {
      "type": "number",
      "default": 0
    },
    "valor_pago": {
      "type": "number",
      "default": 0
    },
    "forma_pagamento": {
      "type": "string",
      "enum": [
        "dinheiro",
        "pix",
        "transferencia",
        "boleto",
        "cartao",
        "cheque"
      ],
      "default": "boleto"
    },
    "parcela_atual": {
      "type": "number",
      "default": 1
    },
    "total_parcelas": {
      "type": "number",
      "default": 1
    },
    "recorrente": {
      "type": "boolean",
      "default": false
    },
    "pagamentos": {
      "type": "array",
      "description": "Hist\u00f3rico de pagamentos registrados",
      "items": {
        "type": "object",
        "properties": {
          "tipo_origem": {
            "type": "string"
          },
          "origem_id": {
            "type": "string"
          },
          "origem_label": {
            "type": "string"
          },
          "valor": {
            "type": "number"
          },
          "data": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "observacoes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "parcial",
        "pago",
        "vencido",
        "cancelado"
      ],
      "default": "pendente"
    }
  },
  "required": [
    "empresa_id",
    "loja_id",
    "descricao",
    "data_vencimento",
    "valor_original"
  ]
}