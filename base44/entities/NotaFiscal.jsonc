{
  "name": "NotaFiscal",
  "type": "object",
  "description": "Notas fiscais de entrada \u2014 suporta Compra CD (com estoque) e Compra Direta Loja (financeiro-only)",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa (tenant)"
    },
    "loja_id": {
      "type": "string",
      "description": "ID da loja que recebeu (para CD: \u00e9 o pr\u00f3prio CD; para direta: loja respons\u00e1vel)"
    },
    "loja_responsavel_id": {
      "type": "string",
      "description": "Loja respons\u00e1vel pela compra (preenchida somente no fluxo Loja Direct)"
    },
    "faturado_para_id": {
      "type": "string",
      "description": "ID da loja ou entidade para quem foi faturado (NB/Pra\u00e7a/Pablo PF)"
    },
    "faturado_para_nome": {
      "type": "string",
      "description": "Nome livre do faturado (quando n\u00e3o for loja cadastrada)"
    },
    "tipo_lancamento": {
      "type": "string",
      "enum": [
        "compra_cd",
        "compra_direta_loja"
      ],
      "default": "compra_cd",
      "description": "compra_cd = gera estoque no CD + AP; compra_direta_loja = somente AP + DRE, sem estoque CD"
    },
    "categoria_dre_id": {
      "type": "string",
      "description": "Categoria DRE (obrigat\u00f3ria em compra_direta_loja)"
    },
    "fornecedor_id": {
      "type": "string",
      "description": "ID do fornecedor"
    },
    "numero": {
      "type": "string",
      "description": "N\u00famero da NF"
    },
    "serie": {
      "type": "string",
      "description": "S\u00e9rie da NF"
    },
    "chave_acesso": {
      "type": "string",
      "description": "Chave de acesso NFe (44 d\u00edgitos)"
    },
    "data_emissao": {
      "type": "string",
      "format": "date"
    },
    "data_entrada": {
      "type": "string",
      "format": "date"
    },
    "valor_produtos": {
      "type": "number",
      "default": 0
    },
    "valor_frete": {
      "type": "number",
      "default": 0
    },
    "valor_desconto": {
      "type": "number",
      "default": 0
    },
    "valor_total": {
      "type": "number",
      "default": 0
    },
    "xml_url": {
      "type": "string"
    },
    "itens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "produto_id": {
            "type": "string"
          },
          "descricao_nf": {
            "type": "string"
          },
          "quantidade": {
            "type": "number"
          },
          "custo_unitario": {
            "type": "number"
          },
          "subtotal": {
            "type": "number"
          },
          "vinculado": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "num_parcelas": {
      "type": "number",
      "default": 1
    },
    "primeiro_vencimento": {
      "type": "string",
      "format": "date"
    },
    "forma_pagamento": {
      "type": "string",
      "enum": [
        "boleto",
        "pix",
        "transferencia",
        "dinheiro",
        "cartao",
        "cheque"
      ],
      "default": "boleto"
    },
    "documento_tipo": {
      "type": "string",
      "enum": [
        "nota_fiscal",
        "boleto",
        "fatura",
        "contrato",
        "outros"
      ],
      "default": "nota_fiscal"
    },
    "parcelas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "numero": {
            "type": "number"
          },
          "vencimento": {
            "type": "string",
            "format": "date"
          },
          "valor": {
            "type": "number"
          }
        }
      }
    },
    "lancado_no_pdv": {
      "type": "boolean",
      "default": false,
      "description": "Controle manual: se a loja j\u00e1 deu entrada no PDV local"
    },
    "observacoes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "conferida",
        "lancada",
        "cancelada"
      ],
      "default": "pendente"
    },
    "processada_ia": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "empresa_id",
    "loja_id",
    "numero"
  ]
}