{
  "name": "FinancialLiability",
  "type": "object",
  "description": "Passivos financeiros e d\u00edvidas estruturadas",
  "properties": {
    "title": {
      "type": "string",
      "description": "Nome da d\u00edvida"
    },
    "type": {
      "type": "string",
      "enum": [
        "cartao",
        "emprestimo",
        "financiamento",
        "fornecedor",
        "cheque_especial",
        "acordo"
      ],
      "description": "Tipo de d\u00edvida"
    },
    "creditor_name": {
      "type": "string",
      "description": "Nome do credor"
    },
    "responsible": {
      "type": "string",
      "enum": [
        "NB",
        "Praca",
        "Pablo PF"
      ],
      "description": "Respons\u00e1vel"
    },
    "loja_id": {
      "type": "string",
      "description": "ID da loja vinculada"
    },
    "original_amount": {
      "type": "number",
      "description": "Valor original da d\u00edvida"
    },
    "current_balance": {
      "type": "number",
      "description": "Saldo devedor atual"
    },
    "amount_paid": {
      "type": "number",
      "default": 0,
      "description": "Valor j\u00e1 pago"
    },
    "interest_rate_monthly": {
      "type": "number",
      "description": "Taxa de juros mensal %"
    },
    "total_installments": {
      "type": "number",
      "description": "Total de parcelas"
    },
    "installment_value": {
      "type": "number",
      "description": "Valor padr\u00e3o de cada parcela (usar quando parcelas s\u00e3o iguais)"
    },
    "has_variable_installments": {
      "type": "boolean",
      "default": false,
      "description": "Se as parcelas t\u00eam valores vari\u00e1veis"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio"
    },
    "first_due_date": {
      "type": "string",
      "format": "date",
      "description": "Data do primeiro vencimento"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "quitado",
        "renegociado"
      ],
      "default": "ativo"
    }
  },
  "required": [
    "title",
    "type",
    "original_amount",
    "total_installments",
    "first_due_date"
  ]
}